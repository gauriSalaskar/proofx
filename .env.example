# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── WalletConnect ────────────────────────────────────────────────────────────
# Get your project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ─── Smart Contracts (fill in after running `npm run deploy:sepolia`) ─────────
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MOCK_USD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_UGF_FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000

# ─── UGF (TychiLabs) ─────────────────────────────────────────────────────────
# Get from https://ugf.tychilabs.com
NEXT_PUBLIC_UGF_RELAY_URL=https://relay.ugf-testnet.tychilabs.com
NEXT_PUBLIC_UGF_API_KEY=your_ugf_api_key_here

# ─── IPFS / Pinata ────────────────────────────────────────────────────────────
# Get from https://app.pinata.cloud
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET=your_pinata_secret_here
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# ─── AI (Optional - for AI description feature) ───────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Deployment (only needed for `npm run deploy:sepolia`) ────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here
UGF_FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000

# ─── BaseScan (optional — for contract verification) ─────────────────────────
BASESCAN_API_KEY=your_basescan_api_key_here
